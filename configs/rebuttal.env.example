# Copy to configs/rebuttal.env and source it from Bash. Do not commit real keys.
export REASONING_URL=http://127.0.0.1:8000/v1
export REASONING_MODEL=Qwen3-8B
export SUPERVISOR_URL=http://127.0.0.1:8000/v1
export SUPERVISOR_MODEL=Qwen3-8B
export SELECTOR_URL=http://127.0.0.1:8001/v1
export SELECTOR_MODEL=Qwen3.5-9B
export EMBEDDING_URL=http://127.0.0.1:8002/v1
export EMBEDDING_MODEL=Qwen3-Embedding-8B
# EMPTY is for a trusted local unauthenticated service only.
export REASONING_KEY=EMPTY
export SUPERVISOR_KEY=EMPTY
export SELECTOR_KEY=EMPTY
export EMBEDDING_KEY=EMPTY
# Set this to the private archive supplied by the project owner.
# export MASRUBRIC_PRIVATE_ASSETS=/path/to/private-assets
# export MASRUBRIC_LIVECODE_FILE=/path/to/livecodebench_v1.jsonl
# Change BOTH reasoner and supervisor to Qwen3-14B for the paper 14B transfer.
